{
  "name": "@confinancas/core-money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./worker": "./src/worker/criar-worker.ts",
    "./web": "./src/web/montar-app.tsx",
    "./vite": "./preset/vite.mjs"
  },
  "bin": {
    "core-money-build": "./bin/core-money-build.mjs",
    "core-money-instalar": "./bin/core-money-instalar.mjs",
    "core-money-recuperar-acesso": "./bin/core-money-recuperar-acesso.mjs"
  },
  "files": [
    "src",
    "migrations",
    "preset",
    "bin",
    "scripts/instalar.ts",
    "scripts/recuperar-acesso.ts",
    "scripts/lib"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "predev:api": "node -e \"require('fs').mkdirSync('dist/client',{recursive:true})\"",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/unit/tsconfig.json --noEmit && tsc -p tests/integration/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply matrimoney-db --local",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/dev/e2e-server.mjs",
    "check:build": "node scripts/dev/check-build.mjs",
    "check:app-fino": "node scripts/dev/check-app-fino.mjs",
    "gate": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run check:build && npm run test:integration",
    "cpu": "node scripts/dev/measure-cpu.mjs",
    "pluggy:sonda": "tsx scripts/dev/pluggy-sonda.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jsonc-parser": "^3.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^28.1.0",
    "vitest": "^4.1.12"
  }
}
